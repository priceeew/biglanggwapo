{
  "name": "biglanggwapo-barber-shop",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n WEB,API -c cyan,yellow \"npm run dev:web\" \"npm run server\"",
    "dev:web": "vite --host 0.0.0.0 --port 3000",
    "server": "node --watch --watch-path=server server/index.js",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0 --port 3000"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "cors": "^2.8.6",
    "dotenv": "^18.0.7",
    "express": "^5.3.0",
    "lucide-react": "latest",
    "mongoose": "^9.11.2",
    "nodemailer": "^10.1.0",
    "react": "latest",
    "react-dom": "latest",
    "react-router-dom": "latest",
    "vite": "latest"
  },
  "description": "A web-based barbershop operations and online appointment scheduling system for **Biglang Gwapo Barbershop** (Pulilan, Bulacan).",
  "main": "vite.config.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/priceeew/biglanggwapo.git"
  },
